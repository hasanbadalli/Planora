# Local development: the browser calls the API directly.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production (Vercel): set NEXT_PUBLIC_API_URL=/api/v1 and point
# API_PROXY_TARGET at the deployed API project so /api/v1/* is proxied
# through this app's own domain (keeps the auth cookie first-party).
# API_PROXY_TARGET=https://your-api-project.vercel.app
